diff --git a/Frontend/src/pages/RoomList.css b/Frontend/src/pages/RoomList.css
new file mode 100644
index 0000000..8dd3e41
--- /dev/null
+++ b/Frontend/src/pages/RoomList.css
@@ -0,0 +1,170 @@
+.room-list-page {
+  padding: 30px 36px;
+}
+
+.room-list-header {
+  margin-bottom: 24px;
+}
+
+.room-list-header h1 {
+  margin: 0 0 6px;
+  font-size: 32px;
+  font-weight: 700;
+  color: #172033;
+}
+
+.room-list-header p {
+  margin: 0;
+  font-size: 15px;
+  color: #64748b;
+}
+
+/* ===== LƯỚI PHÒNG ===== */
+
+.room-grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(210px, 1fr));
+  gap: 20px;
+  max-width: 1000px;
+}
+
+/* ===== CARD ===== */
+
+.room-card {
+  min-height: 155px;
+  padding: 18px 20px;
+  border-radius: 14px;
+  border: 1px solid transparent;
+  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
+  transition: transform 0.2s ease, box-shadow 0.2s ease;
+}
+
+.room-card:hover {
+  transform: translateY(-3px);
+  box-shadow: 0 7px 18px rgba(15, 23, 42, 0.13);
+}
+
+.room-card h3 {
+  margin: 0 0 8px;
+  font-size: 21px;
+  font-weight: 700;
+  color: #172033;
+}
+
+.room-card p {
+  margin: 6px 0;
+  font-size: 14px;
+  color: #334155;
+}
+
+.room-card-status {
+  display: inline-block;
+  margin-bottom: 6px !important;
+  padding: 5px 10px;
+  border-radius: 18px;
+  font-size: 14px;
+  font-weight: 700;
+}
+
+/* ===== PHÒNG TRỐNG - XANH ===== */
+
+.room-card.available {
+  background: #dcfce7;
+  border-color: #86efac;
+}
+
+.room-card.available .room-card-status {
+  background: #bbf7d0;
+  color: #166534;
+}
+
+/* ===== ĐANG CÓ NGƯỜI THUÊ - ĐỎ ===== */
+
+.room-card.occupied {
+  background: #fee2e2;
+  border-color: #fca5a5;
+}
+
+.room-card.occupied .room-card-status {
+  background: #fecaca;
+  color: #991b1b;
+}
+
+/* ===== BẢO TRÌ - ĐỎ ===== */
+
+.room-card.maintenance {
+  background: #fee2e2;
+  border-color: #f87171;
+}
+
+.room-card.maintenance .room-card-status {
+  background: #fecaca;
+  color: #991b1b;
+}
+
+/* ===== ĐÃ ĐẶT TRƯỚC - VÀNG ===== */
+
+.room-card.reserved {
+  background: #fef3c7;
+  border-color: #fcd34d;
+}
+
+.room-card.reserved .room-card-status {
+  background: #fde68a;
+  color: #92400e;
+}
+
+/* ===== TRẠNG THÁI KHÁC ===== */
+
+.room-card.other {
+  background: #f8fafc;
+  border-color: #cbd5e1;
+}
+
+/* ===== NÚT XÓA ===== */
+
+.room-delete-button {
+  margin-top: 10px;
+  padding: 5px 13px;
+  border: 1px solid #dc2626;
+  border-radius: 7px;
+  background: #ffffff;
+  color: #dc2626;
+  font-size: 13px;
+  font-weight: 600;
+  cursor: pointer;
+  transition: 0.2s;
+}
+
+.room-delete-button:hover {
+  background: #dc2626;
+  color: #ffffff;
+}
+
+/* ===== KHÔNG CÓ PHÒNG ===== */
+
+.room-empty {
+  padding: 30px;
+  text-align: center;
+  background: #ffffff;
+  border-radius: 14px;
+  color: #64748b;
+}
+
+/* ===== RESPONSIVE ===== */
+
+@media (max-width: 1000px) {
+  .room-grid {
+    grid-template-columns: repeat(2, minmax(200px, 1fr));
+  }
+}
+
+@media (max-width: 650px) {
+  .room-list-page {
+    padding: 20px 16px;
+  }
+
+  .room-grid {
+    grid-template-columns: 1fr;
+  }
+}
